# Configuration for the research demo (Forschungsnavigator), read by research/research_demo.
# The clinical cockpit and voice demo use their own .env files in agent-cockpit/ and patient-voice/.
AZURE_TENANT_ID=
# Your Foundry project (Overview page) and its full ARM resource ID
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-FOUNDRY-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_PROJECT_RESOURCE_ID=
# Dedicated Fabric workspace for the synthetic research data
FABRIC_WORKSPACE_ID=
