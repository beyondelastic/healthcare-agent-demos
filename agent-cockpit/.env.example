# Foundry project endpoint (Foundry portal > your project > Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# Directory (tenant) that owns the project; used for the Azure CLI sign-in
AZURE_TENANT_ID=
WRITER_AGENT_NAME=cockpit-writer
REVIEWER_AGENT_NAME=cockpit-reviewer
# Existing model deployment names in your project (structured outputs required)
WRITER_MODEL=gpt-4.1
# Reviewer: stronger reasoning model (gpt-4.1 was too lenient in tests)
REVIEWER_MODEL=gpt-5.5
# QR code on the patient copy: URL of the voice demo (Entlass-Assistent)
VOICE_ASSISTANT_URL=http://127.0.0.1:8010/patient?brief=DEMO-EB-2026-1106
