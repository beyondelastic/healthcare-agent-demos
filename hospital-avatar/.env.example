# Foundry project endpoint (Foundry portal > your project > Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# Directory (tenant) that owns the project; used for the Azure CLI sign-in
AZURE_TENANT_ID=
FOUNDRY_AVATAR_AGENT_NAME=hospital-welcome-avatar
# Service-managed realtime model available to voice agents in your region
FOUNDRY_AVATAR_AGENT_MODEL=gpt-realtime-2.1
# Multilingual Azure HD voice
FOUNDRY_AVATAR_AGENT_VOICE=de-DE-Seraphina:DragonHDLatestNeural
FOUNDRY_AVATAR_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Standard video avatar (region must support real-time avatars)
FOUNDRY_AVATAR_CHARACTER=nia
FOUNDRY_AVATAR_STYLE=
