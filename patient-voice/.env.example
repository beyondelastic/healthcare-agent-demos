# Foundry project endpoint (Foundry portal > your project > Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
# Directory (tenant) that owns the project; used for the Azure CLI sign-in
AZURE_TENANT_ID=
FOUNDRY_VOICE_AGENT_NAME=patient-discharge-voice
# Service-managed realtime model available to voice agents in your region
FOUNDRY_VOICE_AGENT_MODEL=gpt-realtime-2.1
# Multilingual Azure HD voice for spoken replies
FOUNDRY_VOICE_AGENT_VOICE=de-DE-Seraphina:DragonHDLatestNeural
# Display transcripts of the patient's speech (the realtime model hears the audio directly)
FOUNDRY_VOICE_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# URL encoded in the QR code on the printed letter (use an HTTPS tunnel/deployment for phones)
PUBLIC_BASE_URL=http://127.0.0.1:8010
# Foundry resource ARM ID (resource > JSON view); only for setup_guardrail.py
FOUNDRY_ACCOUNT_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>
